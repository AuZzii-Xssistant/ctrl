{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "CTRL default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-spawn",
    "shell:allow-execute",
    "dialog:allow-open",
    "dialog:allow-save",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister"
  ]
}
